# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/cryptomind

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kraken ────────────────────────────────────────────────────────────────────
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_SECRET_KEY=your_kraken_secret_key

# ── Binance WebSocket (prix temps réel) ───────────────────────────────────────
BINANCE_WS_URL=wss://stream.binance.com:9443/stream

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_RECIPIENT=whatsapp:+33xxxxxxxxx

# ── CoinGecko ─────────────────────────────────────────────────────────────────
COINGECKO_API_KEY=

# ── Trading Configuration ─────────────────────────────────────────────────────
PAPER_TRADING=true
TOTAL_CAPITAL_USD=1000.0
BASE_POSITION_SIZE_PCT=2.0
MAX_POSITION_SIZE_PCT=5.0
STOP_LOSS_PCT=7.0
DRAWDOWN_DISABLE_PCT=12.0
MAX_CONSECUTIVE_LOSSES=3
VOLATILITY_HIGH_THRESHOLD=0.05

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── eToro — Agent Portfolio actions + or (module etoro/) ──────────────────────
# Laisser ETORO_API_KEY vide = module désactivé, CryptoMind tourne comme avant.
# Clés : etoro.com > Settings > Trading > API Key Management (environnement Demo d'abord).
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_TRADING_MODE=demo
# Passage en réel bloqué tant que les identifiants démo ne sont pas révoqués au profit d'une clé scopée
ETORO_CREDENTIALS_ROTATED=false
ETORO_PORTFOLIO_ID=
ETORO_KILL_SWITCH_TOKEN=
ETORO_AGENT_ENABLED=true
ETORO_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META,NEM,AEM
ETORO_MAX_OPEN_POSITIONS=3
ETORO_COOLDOWN_HOURS=4
ETORO_DAILY_LOSS_LIMIT_PCT=3.0
ETORO_MIN_SCORE=70
ETORO_SL_PCT=2.0
ETORO_TP_PCT=4.0
ETORO_POSITION_SIZE_PCT=10
ETORO_STATE_PATH=/data/etoro_state.json
ETORO_DECISIONS_PATH=/data/etoro_decisions.jsonl
ETORO_USE_RANKINGS=true
ETORO_USE_NEWS=true
NEWS_API_KEY=

# ── Veille prix + news (watch/) — observation seulement, aucun ordre ─────────
WATCH_ENABLED=false
WATCH_INTERVAL_S=300
WATCH_MOVE_THRESHOLD_PCT=2.0
WATCH_NEWS_INTERVAL_S=900
WATCH_NEWS_SOURCES=yahoo,cryptopanic
CRYPTOPANIC_TOKEN=
WATCH_LOG_PATH=/data/observations.jsonl

# ── Telegram (alertes de veille + événements de trading, deux chats séparés) ──
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_WATCH=
TELEGRAM_CHAT_ID_TRADING=
TELEGRAM_WEBHOOK_SECRET=
# URL publique du backend (Render) : enregistre le webhook au démarrage
TELEGRAM_PUBLIC_URL=

# Persistance eToro dans Supabase (état + journal des décisions) et boucle de l'agent
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ETORO_RUN_AGENT=false
ETORO_CYCLE_INTERVAL_S=300
